# Supabase keys
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=<YOUR-SUPABASE-ANON-KEY>
JWT_SECRET_KEY=super-secret-jwt-token-with-at-least-32-characters-long

# Encryption Key (useful for encrypting secrets in the database)
ENCRYPTION_KEY=<ENCRYPTION_KEY>

# Model provider API Keys
OPENAI_API_KEY=<OPENAI_API_KEY>
GEMINI_API_KEY=<GEMINI_API_KEY>
XAI_API_KEY=<XAI_API_KEY>
ELEVENLABS_API_KEY=<ELEVENLABS_API_KEY>
HUME_API_KEY=<HUME_API_KEY>

# local development
HOST=0.0.0.0
PORT=8000
DEV_MODE=True

# Record the uplink (mic) audio per connection as a WAV (disable when done).
#   DEBUG_AUDIO=file      -> debug_audio_<ts>_<mac>_<provider>_<rate>Hz.wav next to main.ts
#   DEBUG_AUDIO=supabase  -> upload to Supabase Storage bucket "debug-audio" on
#                            disconnect (Deno Deploy); needs the service role key
#   DEBUG_AUDIO=1         -> auto (supabase on Deno Deploy, file otherwise)
# DEBUG_AUDIO=1
# SUPABASE_SERVICE_ROLE_KEY=<YOUR-SUPABASE-SERVICE-ROLE-KEY>
# DEBUG_AUDIO_BUCKET=debug-audio
