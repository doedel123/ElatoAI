# Supabase keys
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=<YOUR-SUPABASE-ANON-KEY>
JWT_SECRET_KEY=super-secret-jwt-token-with-at-least-32-characters-long

# Encryption Key (useful for encrypting secrets in the database)
ENCRYPTION_KEY=<ENCRYPTION_KEY>

# Model provider API Keys
OPENAI_API_KEY=<OPENAI_API_KEY>
GEMINI_API_KEY=<GEMINI_API_KEY>
# Shared by Gemini concierge and direct personalities; this is also the code default.
GEMINI_LIVE_MODEL=gemini-3.8-live
XAI_API_KEY=<XAI_API_KEY>
ELEVENLABS_API_KEY=<ELEVENLABS_API_KEY>
HUME_API_KEY=<HUME_API_KEY>

# local development
HOST=0.0.0.0
PORT=8000
DEV_MODE=True


# Server-only key for writes the device session cannot do as anon: storing
# concierge-created personalities and their portraits (create_personality).
# Never ship this to a browser or device.
SUPABASE_SERVICE_ROLE_KEY=<YOUR-SUPABASE-SERVICE-ROLE-KEY>

# Optional account-scoped face recognition (xiaozhi, Gemini / OpenAI).
# Apply 20260920120000_add_known_people.sql before enabling.
FACE_RECOGNITION_ENABLED=false
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=<YOUR-AWS-ACCESS-KEY-ID>
AWS_SECRET_ACCESS_KEY=<YOUR-AWS-SECRET-ACCESS-KEY>
# AWS_SESSION_TOKEN=... # only for temporary AWS credentials
